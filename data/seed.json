 "templates": [
  {
   "id": "tp-001",
   "name": "First Response (WhatsApp)",
   "channel": "WhatsApp",
   "trigger": "Stage Change",
   "subject": "",
   "body": "Assalam-o-Alaikum {{student_name}}! This is {{counselor_name}} from {{brand}}. Thanks for your interest in {{country}} for {{intake}}. I've reviewed your profile — can we do a free 20-min counselling call tomorrow? We'll cover university shortlist, cost breakdown and visa success factors."
  },
  {
   "id": "tp-002",
   "name": "Doc Checklist Reminder",
   "channel": "WhatsApp",
   "trigger": "Doc Pending",
   "subject": "Pending documents — {{app_title}}",
   "body": "Dear {{student_name}}, the following are still PENDING for your {{country}} application:\n{{pending_docs}}\n⚠ Missing docs push your intake back — UK/Ireland strictly enforce the 28-day financial rule. Please share by {{due_date}}. Any questions, call me on {{counselor_phone}}."
  },
  {
   "id": "tp-003",
   "name": "28-Day Funds Rule (UK/IE)",
   "channel": "WhatsApp",
   "trigger": "Doc Pending",
   "subject": "",
   "body": "{{student_name}}, important UK/IE rule: your account must hold the required funds for 28 CONSECUTIVE days, and the statement must be dated within 31 days of application. Please do NOT spend from that account, don't add new deposits, and send me the fresh statement on day 29."
  },
  {
   "id": "tp-004",
   "name": "Fee Reminder",
   "channel": "WhatsApp",
   "trigger": "Fee Due",
   "subject": "Invoice {{invoice_no}}",
   "body": "Dear {{student_name}}, our records show {{head}} of PKR {{amount}} is due on {{due_date}} (invoice {{invoice_no}}). To avoid delays in filing with the university/embassy, please clear it via {{pay_channel}} and share a screenshot here. Thank you — {{brand}} Accounts."
  },
  {
   "id": "tp-005",
   "name": "Visa Kit Ready / CAS Instructions",
   "channel": "Email",
   "trigger": "Stage Change",
   "subject": "{{country}} Visa — next steps & CAS instructions",
   "body": "Dear {{student_name}},\n\nCongratulations — your {{university_name}} CAS/acceptance is issued. Next steps in order:\n1. Verify all CAS details within 6 months of use.\n2. Complete TB/medical test ({{medical_center}}) — book now, slots fill fast.\n3. Pay IHS/insurance and keep the reference number.\n4. Upload financials — 28-day rule applies.\n5. Biometrics: {{biometric_slot}}\n\nDocument list attached. Reply to this email with the completed set.\n\nRegards,\n{{counselor_name}}, {{brand}}"
  },
  {
   "id": "tp-006",
   "name": "Passport Lodged with Embassy",
   "channel": "SMS",
   "trigger": "Manual",
   "subject": "",
   "body": "{{student_name}}: your passport is with the {{country}} embassy (filed {{filed_date}}). Standard processing 15-30 working days. We update you every Friday. — {{brand}}"
  },
  {
   "id": "tp-007",
   "name": "Pre-departure Briefing Invite",
   "channel": "WhatsApp",
   "trigger": "Pre-departure",
   "subject": "Pre-departure briefing",
   "body": "{{student_name}}, your briefing is booked for {{briefing_date}} at {{branch}}. Bring: passport, CAS/eVAL originals, offer letter, forex receipts, accommodation contract. We'll cover airport pickup, SIMS, bank account in the UK, part-time work rules (20 hrs/week) and what to declare at customs."
  },
  {
   "id": "tp-008",
   "name": "Agent Commission Statement",
   "channel": "Email",
   "trigger": "Manual",
   "subject": "Commission statement — {{period}}",
   "body": "Dear {{partner_name}},\n\nConfirmed placements for the period:\n{{commission_rows}}\n\nTotal payable: PKR {{commission_total}}\nRelease policy: 100% after visa approval, subject to a signed current agreement (see expiry).\n\nRegards,\nAccounts, {{brand}}"
  },
  {
   "id": "tp-009",
   "name": "EMGS Timeline Update (Malaysia)",
   "channel": "WhatsApp",
